# Local-only settings for the Discord provisioning script. Copy to discord/.env:
#   cp discord/.env.example discord/.env        (PowerShell: Copy-Item discord/.env.example discord/.env)
# discord/.env is ignored by git. Never commit the token or paste it anywhere public.

# Discord Developer Portal → your application → Bot → Reset Token → copy
DISCORD_BOT_TOKEN=

# Discord: User Settings → Advanced → Developer Mode on; then right-click the server icon → Copy Server ID
DISCORD_GUILD_ID=

# Optional. Only needed for `--invite-url` if it can't be read from the token.
# Developer Portal → your application → General Information → Application ID
DISCORD_CLIENT_ID=
