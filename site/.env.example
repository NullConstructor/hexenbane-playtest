# Public website configuration. Copy to site/.env.local for local development:
#   cp site/.env.example site/.env.local      (PowerShell: Copy-Item site/.env.example site/.env.local)
#
# EVERY value here ends up in the public website's JavaScript. Only put values here that are
# safe for anyone on the internet to read. NEVER put any of these here (or in GitHub Pages):
#   - the Supabase service_role / secret key
#   - the Discord webhook URL
#   - the Discord bot token
# The build refuses VITE_ variables whose names look like secrets.

# Supabase project URL. Dashboard → Project Settings → API (or the Connect button).
# Local `supabase start`: http://127.0.0.1:54321
VITE_SUPABASE_URL=

# Optional. The public anon / publishable key. Not needed while the function is deployed
# with JWT verification off (the default here, see supabase/config.toml); set it only if you
# turn verification on. Never the service_role or secret key.
VITE_SUPABASE_ANON_KEY=

# Your Hexenbane Discord invite, e.g. https://discord.gg/abcd1234 (set to never expire).
VITE_DISCORD_INVITE_URL=

# Optional. Cloudflare Turnstile site key (public). Leave empty to keep the CAPTCHA off.
VITE_TURNSTILE_SITE_KEY=

# Optional. Override the submission endpoint. Defaults to
# $VITE_SUPABASE_URL/functions/v1/submit-playtest-application
VITE_SUBMIT_URL=
