# Secrets for the submit-playtest-application Edge Function.
#
# Hosted: set these in Supabase (Dashboard → Edge Functions → Secrets, or
#   npx supabase secrets set --env-file supabase/functions/.env
# ). Local: copy to supabase/functions/.env and run
#   npx supabase functions serve --env-file supabase/functions/.env
#
# NEVER put any of these in the website, in VITE_ variables or in GitHub.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# Discord → #playtest-applications → Edit Channel → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Browser origins allowed to submit, comma-separated. Origin only: no path, no trailing slash.
# Example: https://nullconstructor.github.io,http://localhost:5173
ALLOWED_ORIGINS=

# Optional: Cloudflare Turnstile secret key. Leave unset to keep the CAPTCHA off.
TURNSTILE_SECRET_KEY=
