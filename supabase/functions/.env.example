# Secrets for the Edge Functions: submit-playtest-application (the website) and
# ingest-telemetry, submit-crash, submit-feedback (the game).
#
# Hosted: set these in Supabase (Dashboard → Edge Functions → Secrets, or
#   npx supabase secrets set --env-file supabase/functions/.env
# ). Local: copy to supabase/functions/.env and run
#   npx supabase functions serve --env-file supabase/functions/.env
#
# NEVER put any of these in the website, in VITE_ variables or in GitHub.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# Discord → #playtest-applications → Edit Channel → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Browser origins allowed to submit, comma-separated. Origin only: no path, no trailing slash.
# Example: https://nullconstructor.github.io,http://localhost:5173
ALLOWED_ORIGINS=

# Optional: Cloudflare Turnstile secret key. Leave unset to keep the CAPTCHA off.
TURNSTILE_SECRET_KEY=

# ── The game's endpoints (ingest-telemetry, submit-crash, submit-feedback) ──

# Discord → #bug-reports (forum) → Edit Channel → Integrations → Webhooks → Copy Webhook URL.
# F8 reports and the first report of each crash become forum posts here.
DISCORD_BUG_REPORTS_WEBHOOK_URL=

# Optional: #bug-reports forum tag ids as JSON, so posts get tagged. Names: New, Crash, UI, Combat.
# Example: {"New":"123456789012345678","Crash":"234567890123456789","UI":"345678901234567890","Combat":"456789012345678901"}
DISCORD_BUG_REPORTS_TAGS=

# A long random string (e.g. `openssl rand -hex 32`). Salts the hash of caller IPs used for
# per-IP rate limits; raw IPs are never stored. Unset = per-IP limits off.
RATE_LIMIT_IP_SALT=
